# ==============================================================================
# AI IT OPERATIONS - CONFIGURATION D'ENVIRONNEMENT
# ==============================================================================

# --- ENVIRONNEMENT APPLICATIF ---
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_SECRET_KEY=change-this-ultra-secure-random-secret-key-in-production-min32chars
API_PORT=8005
FRONTEND_PORT=3005

# --- BASE DE DONNEES POSTGRESQL + PGVECTOR ---
# Port externe 5435 pour éviter conflit avec 5432/5433/5434
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=aiops_db
POSTGRES_USER=aiops_user
POSTGRES_PASSWORD=aiops_secure_password
DATABASE_URL=postgresql+asyncpg://aiops_user:aiops_secure_password@localhost:5435/aiops_db

# --- MESSAGERIE REDIS STREAMS ---
# Port externe 6380 pour éviter conflit avec 6379
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=aiops_redis_password
REDIS_URL=redis://:aiops_redis_password@localhost:6380/0

# --- INTÉGRATION ZABBIX ---
# En mode lab: pointer vers http://localhost:8005/api/v1/lab/zabbix ou http://localhost:10051
ZABBIX_URL=http://localhost:8080/zabbix
ZABBIX_API_URL=http://localhost:8080/zabbix/api_jsonrpc.php
ZABBIX_USER=Admin
ZABBIX_PASSWORD=zabbix
ZABBIX_API_TOKEN=your-zabbix-api-token-if-configured
ZABBIX_WEBHOOK_SECRET=zabbix-webhook-shared-hmac-secret-key-32chars

# --- INTÉGRATION GLPI (REST API v10 / v9) ---
# En mode lab: pointer vers http://localhost:8005/api/v1/lab/glpi
GLPI_API_URL=http://localhost:8088/glpi/apirest.php
GLPI_APP_TOKEN=glpi_app_token_secret
GLPI_USER_TOKEN=glpi_user_token_secret
GLPI_USERNAME=glpi
GLPI_PASSWORD=glpi
GLPI_DEFAULT_ENTITY_ID=0

# --- INTELLIGENCE ARTIFICIELLE & LLM ---
# Fournisseur LLM: 'ollama' | 'openai' | 'anthropic' | 'disabled'
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
# Optionnel: modèles alternatifs
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60

# --- RAG & EMBEDDINGS ---
# Fournisseur d'embeddings: 'ollama' | 'huggingface' | 'local_mock'
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
RAG_SIMILARITY_THRESHOLD=0.65
RAG_TOP_K=4

# --- OBSERVABILITE ---
PROMETHEUS_PORT=9095
GRAFANA_PORT=3006
GRAFANA_ADMIN_PASSWORD=admin_aiops_pass
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- MODE LABORATOIRE (SIMULATION POUR TESTS DÉTERMINISTES) ---
LAB_MODE_ENABLED=true
