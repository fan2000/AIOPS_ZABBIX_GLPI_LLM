FROM node:20-alpine AS builder

WORKDIR /app

COPY apps/frontend/package*.json ./
RUN npm install

COPY apps/frontend/ ./
RUN mkdir -p public && npm run build

FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 10001 aiops && adduser --system --uid 10001 aiops

COPY --from=builder --chown=aiops:aiops /app/public ./public
COPY --from=builder --chown=aiops:aiops /app/.next/standalone ./
COPY --from=builder --chown=aiops:aiops /app/.next/static ./.next/static

USER aiops

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

CMD ["node", "server.js"]
