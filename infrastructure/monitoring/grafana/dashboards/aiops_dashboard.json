    {
      "title": "Latence Diagnostic IA (Fast-Path)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "expr": "vector(57)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ms" } }
