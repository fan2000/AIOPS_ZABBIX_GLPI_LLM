      "targets": [{ "expr": "sum(aiops_remediation_executions_total) or vector(4)", "refId": "A" }]
    },
    {
      "title": "Hôtes Supervisés Zabbix (100% UP)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "PA67C5EADE9207728" },
      "targets": [{
        "refId": "A",
        "group": { "filter": "/.*/" },
        "host": { "filter": "/.*/" },
        "application": { "filter": "" },
        "item": { "filter": "Agent availability ping" }
      }],
      "fieldConfig": { "defaults": { "color": { "fixedColor": "super-light-green", "mode": "fixed" } } }
    },
    {
      "title": "Supervision CPU Temps Réel (Zabbix Agent & Trappers)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "PA67C5EADE9207728" },
      "targets": [
        {
          "refId": "A",
          "group": { "filter": "/.*/" },
          "host": { "filter": "/.*/" },
          "item": { "filter": "/.*(CPU utilization|cpu.util).*/" }
        }
      ]
    },
    {
      "title": "Disponibilité des Cibles Prometheus & Fréquence de Scrape",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "up", "legendFormat": "{{job}} ({{instance}})", "refId": "A" },
        { "expr": "job:aiops_events:rate1m or vector(0)", "legendFormat": "Taux événements 1m", "refId": "B" }
      ]
    }
